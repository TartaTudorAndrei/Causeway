# ==============================================================================
# Causeway Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Connection string from Neon dashboard (or local postgres URL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 2. Server & Security Configuration
# ------------------------------------------------------------------------------
PORT=8080
FRONTEND_PORT=8000
BACKEND_PORT=8080
PGPORT_HOST=5432
JWT_SECRET=causeway_super_secret_jwt_signing_key_2026_at_least_32_bytes_long
JWT_EXPIRATION_HOURS=8
WHATSAPP_INTERNAL_SECRET=causeway_internal_secret_key_2026

# ------------------------------------------------------------------------------
# 3. Google OAuth & Frontend Credentials
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 4. Google Integrations (Gmail, Sheets, Apps Script)
# ------------------------------------------------------------------------------
GMAIL_CREDENTIALS_JSON=
GMAIL_REFRESH_TOKEN=
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ------------------------------------------------------------------------------
# 5. Gemini Vision OCR
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 6. Stripe Payments API Settings
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# ------------------------------------------------------------------------------
# 7. SMTP / Jakarta Mail Configuration
# ------------------------------------------------------------------------------
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CHARITY_EMAIL_FROM=contact@example.org
CHARITY_EMAIL_SUBJECT_PICKUP_CODE=Causeway - Your Pickup Code

# ------------------------------------------------------------------------------
# 8. Business Logic & Frontend Redirects
# ------------------------------------------------------------------------------
APP_PICKUP_THRESHOLD=30.0
APP_DEFAULT_CURRENCY=ron
APP_FRONTEND_SUCCESS_URL=https://example.org/donate/success
APP_FRONTEND_CANCEL_URL=https://example.org/donate
